function instrument_numbers = get_instruments_from_mode(mode)
    % This function returns an array of MIDI instrument numbers based on the given mode.
    % The output array is in the order: [melody, harmony, bass]

    % Define MIDI instrument numbers for each mode
    instruments = struct(... 
        'Ionian', struct('Melody', 1, 'Harmony', 49, 'Bass', 33), ... % Piano, String Enseble, Acoustic bass
        'Dorian', struct('Melody', 41, 'Harmony', 25, 'Bass', 44), ... % Violin, Guitar (Nylon), Contrabass
        'Phrygian', struct('Melody', 73, 'Harmony', 20, 'Bass', 54), ... % Flute, C, Bass (Voices)
        'Lydian', struct('Melody', 65, 'Harmony', 28, 'Bass', 58), ... % Soprano Sax, Electric Guitar, Trombone
        'Mixolydian', struct('Melody', 80, 'Harmony', 6, 'Bass', 34), ... % Ocarina, Electric Piano, Electric Bass
        'Aeolian', struct('Melody', 43, 'Harmony', 49, 'Bass', 58), ... % Solo Cello, String Enseble, Trombone
        'Locrian', struct('Melody', 73, 'Harmony', 20, 'Bass', 39) ... % Bass Flute, Organ, Synth Bass
    );

    % Check if the mode is valid
    if isfield(instruments, mode)
        % Return the MIDI instrument numbers for the given mode
        instrument_numbers = [instruments.(mode).Melody, instruments.(mode).Harmony, instruments.(mode).Bass];
    else
        error('Invalid mode. Please choose from: Ionian, Dorian, Phrygian, Lydian, Mixolydian, Aeolian, Locrian.');
    end
end
